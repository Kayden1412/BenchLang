# ========================
# Combined .gitignore for C, C++, Go, Rust, Zig
# ========================

# --- OS & Editors ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
*.code-workspace
*.log
.env
.env.local

# ========================
# C / C++
# ========================
# Compiled Object files
*.o
*.ko
*.obj
*.lo
*.slo
*.elf

# Precompiled Headers
*.gch
*.pch

# Libraries
*.a
*.la
*.lai
*.so
*.dylib
*.dll
*.lib

# Executables
*.exe
*.out
*.app
*.i
*.s

# Debug / Coverage
*.dSYM/
*.su
*.idb
*.pdb
*.gcno
*.gcda
*.gcov
*.d

# Build systems
build/
build-*/
out/
bin/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
_deps
CMakeScripts/
Testing/
# Dependency / package managers
vcpkg_installed/
.conan/
conan.lock

# ========================
# Go
# ========================
# Binaries for programs and plugins
*.test

# Go workspace file
go.work
go.work.sum

# Vendor - uncomment if you don't want to commit dependencies
# vendor/

# ========================
# Rust
# ========================
# Generated by Cargo
/target/
**/*.rs.bk
# Keep Cargo.lock for binaries, ignore for libraries - choose one:
# Cargo.lock

# ========================
# Zig
# ========================
zig-cache/
zig-out/
.zig-cache/
.zig/
